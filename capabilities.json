{
  "dataRoles": [
    {
      "name": "latitude",
      "kind": "Grouping",
      "displayName": "Latitude",
      "description": "Latitude coordinate"
    },
    {
      "name": "longitude",
      "kind": "Grouping",
      "displayName": "Longitude",
      "description": "Longitude coordinate"
    },
    {
      "name": "tooltip",
      "kind": "Grouping",
      "displayName": "Tooltip",
      "description": "Tooltip information - first column as title, rest as paragraph"
    },
    {
      "name": "color",
      "kind": "Grouping",
      "displayName": "Color",
      "description": "Color for markers and clusters"
    }
  ],
  "dataViewMappings": [
    {
      "table": {
        "rows": {
          "select": [
            {
              "bind": {
                "to": "latitude"
              }
            },
            {
              "bind": {
                "to": "longitude"
              }
            },
            {
              "for": {
                "in": "tooltip"
              }
            },
            {
              "for": {
                "in": "color"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "mapSettings": {
      "displayName": "Map Settings",
      "properties": {
        "baseMapUrl": {
          "displayName": "Base Map GeoJSON URL",
          "description": "Public URL to load base map GeoJSON data from",
          "type": {
            "text": true
          }
        },
        "disputedBordersUrl": {
          "displayName": "Disputed Borders GeoJSON URL",
          "description": "Public URL to load disputed borders GeoJSON data from",
          "type": {
            "text": true
          }
        }
      }
    }
  },
  "privileges": [
    {
      "name": "WebAccess",
      "essential": true,
      "parameters": ["https://*.microsoft.com", "https://*"]
    }
  ]
}
